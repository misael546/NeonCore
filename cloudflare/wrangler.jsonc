{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neoncore-realtime-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEON_ROOM",
        "class_name": "NeonRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NeonRoom"]
    }
  ]
}
